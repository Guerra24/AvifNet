<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <Title>AvifNet</Title>
    <Authors>Guerra24</Authors>
    <Description>Native bindings for libavif</Description>
    <PackageId>AvifNet</PackageId>
    <PackageProjectUrl>https://github.com/Guerra24/AvifNet</PackageProjectUrl>
    <PackageTags>libavif;avif;decoder;encoder</PackageTags>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Guerra24/AvifNet</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" Version="6.0.0" />
  </ItemGroup>

</Project>
